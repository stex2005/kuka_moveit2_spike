<?xml version="1.0"?>
<robot name="kr_70_r2100" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_fake_hardware" default="true"/>

  <xacro:include filename="$(find kuka_moveit2_spike)/urdf/kr_70_r2100.ros2_control.xacro"/>

  <xacro:property name="mesh_dir" value="package://kuka_moveit2_spike/meshes"/>

  <!-- ==================== Links ==================== -->

  <link name="base_link">
    <inertial>
      <origin xyz="0.18214323685253 -0.030374158086361 0.956536163087158" rpy="0 0 0"/>
      <mass value="559"/>
      <inertia ixx="300.413165720827" ixy="0.226872889869252" ixz="-85.3930667863479"
               iyy="351.250186540615" iyz="5.16499915063217" izz="73.3918569278715"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.175" rpy="0 0 0.7853982"/>
      <geometry><mesh filename="${mesh_dir}/base_link_D.STL"/></geometry>
      <material name="kuka_silver"><color rgba="0.792 0.820 0.933 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.175" rpy="0 0 0.7853982"/>
      <geometry><mesh filename="${mesh_dir}/base_link_D.STL"/></geometry>
    </collision>
  </link>

  <link name="link_A1">
    <inertial>
      <origin xyz="0.18214323685253 -0.030374158086361 0.956536163087158" rpy="0 0 0.7853982"/>
      <mass value="559"/>
      <inertia ixx="300.413165720827" ixy="0.226872889869252" ixz="-85.3930667863479"
               iyy="351.250186540615" iyz="5.16499915063217" izz="73.3918569278715"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/link_A1.STL"/></geometry>
      <material name="kuka_dark"><color rgba="0.4 0.4 0.4 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/link_A1.STL"/></geometry>
    </collision>
  </link>

  <link name="link_A2">
    <inertial>
      <origin xyz="0.18214323685253 -0.030374158086361 0.956536163087158" rpy="0 0 0"/>
      <mass value="559"/>
      <inertia ixx="300.413165720827" ixy="0.226872889869252" ixz="-85.3930667863479"
               iyy="351.250186540615" iyz="5.16499915063217" izz="73.3918569278715"/>
    </inertial>
    <visual>
      <origin xyz="-0.17 0.08 -0.58" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/link_A2.STL"/></geometry>
      <material name="kuka_silver"/>
    </visual>
    <collision>
      <origin xyz="-0.17 0.08 -0.58" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/link_A2.STL"/></geometry>
    </collision>
  </link>

  <link name="link_A3">
    <inertial>
      <origin xyz="0.18214323685253 -0.030374158086361 0.956536163087158" rpy="0 0 0"/>
      <mass value="559"/>
      <inertia ixx="300.413165720827" ixy="0.226872889869252" ixz="-85.3930667863479"
               iyy="351.250186540615" iyz="5.16499915063217" izz="73.3918569278715"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/link_A3.STL"/></geometry>
      <material name="kuka_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/link_A3.STL"/></geometry>
    </collision>
  </link>

  <link name="cable_guide_mount">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/cable_guide_mount.STL"/></geometry>
      <material name="kuka_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/cable_guide_mount.STL"/></geometry>
    </collision>
  </link>

  <link name="link_A4">
    <inertial>
      <origin xyz="0.18214323685253 -0.030374158086361 0.956536163087158" rpy="0 0 0"/>
      <mass value="559"/>
      <inertia ixx="300.413165720827" ixy="0.226872889869252" ixz="-85.3930667863479"
               iyy="351.250186540615" iyz="5.16499915063217" izz="73.3918569278715"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/link_A4.STL"/></geometry>
      <material name="kuka_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/link_A4.STL"/></geometry>
    </collision>
  </link>

  <link name="link_A5">
    <inertial>
      <origin xyz="0.18214323685253 -0.030374158086361 0.956536163087158" rpy="0 0 0"/>
      <mass value="559"/>
      <inertia ixx="300.413165720827" ixy="0.226872889869252" ixz="-85.3930667863479"
               iyy="351.250186540615" iyz="5.16499915063217" izz="73.3918569278715"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/link_A5.STL"/></geometry>
      <material name="kuka_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/link_A5.STL"/></geometry>
    </collision>
  </link>

  <link name="link_A6">
    <inertial>
      <origin xyz="0.18214323685253 -0.030374158086361 0.956536163087158" rpy="0 0 0"/>
      <mass value="559"/>
      <inertia ixx="300.413165720827" ixy="0.226872889869252" ixz="-85.3930667863479"
               iyy="351.250186540615" iyz="5.16499915063217" izz="73.3918569278715"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/link_A6.STL"/></geometry>
      <material name="kuka_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="${mesh_dir}/link_A6.STL"/></geometry>
    </collision>
  </link>

  <!-- ==================== Joints ==================== -->

  <joint name="joint_a1" type="revolute">
    <origin xyz="0 0 0.175" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="link_A1"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-3.2289" upper="3.2289" effort="0" velocity="3.0543"/>
  </joint>

  <joint name="joint_a2" type="revolute">
    <origin xyz="0.175 -0.078063 0.405" rpy="0.0013336 1.5708 0"/>
    <parent link="link_A1"/>
    <child link="link_A2"/>
    <axis xyz="0 1 0.0013336"/>
    <limit lower="-3.0543" upper="1.0472" effort="0" velocity="2.7576"/>
  </joint>

  <joint name="joint_a3" type="revolute">
    <origin xyz="0 -0.00172032615170126 0.88999885289791" rpy="1.57079634169155 -1.5694627402354 -1.57079632679441"/>
    <parent link="link_A2"/>
    <child link="link_A3"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.9671" effort="0" velocity="3.0543"/>
  </joint>

  <joint name="link_A3_to_cable_guide_mount" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="link_A3"/>
    <child link="cable_guide_mount"/>
  </joint>

  <joint name="joint_a4" type="revolute">
    <origin xyz="0.3268 0.078063 0.05" rpy="0 0 0"/>
    <parent link="link_A3"/>
    <child link="link_A4"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="0" velocity="2"/>
  </joint>

  <joint name="joint_a5" type="revolute">
    <origin xyz="0.7082 0 0" rpy="0 0 0"/>
    <parent link="link_A4"/>
    <child link="link_A5"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.1817" upper="2.1817" effort="0" velocity="4.3633"/>
  </joint>

  <joint name="joint_a6" type="revolute">
    <origin xyz="0.145 0 0" rpy="-0.523599 0 0"/>
    <parent link="link_A5"/>
    <child link="link_A6"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-6.1087" upper="6.1087" effort="0" velocity="6.2832"/>
  </joint>

  <!-- ==================== ros2_control ==================== -->

  <xacro:kr70_ros2_control use_fake_hardware="$(arg use_fake_hardware)"/>

</robot>
