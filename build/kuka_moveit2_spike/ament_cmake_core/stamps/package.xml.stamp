<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kuka_moveit2_spike</name>
  <version>0.0.1</version>
  <description>Feasibility spike: KUKA kr_70_r2100 with MoveIt2 and ros2_control</description>
  <maintainer email="dev@contoro.com">contoro</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rclcpp</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_py</depend>
  <depend>moveit_planners_ompl</depend>
  <depend>moveit_configs_utils</depend>
  <depend>robot_state_publisher</depend>
  <depend>controller_manager</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>joint_trajectory_controller</depend>
  <depend>xacro</depend>
  <depend>rviz2</depend>
  <depend>moveit_ros_visualization</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
